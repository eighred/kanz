#!/usr/bin/env python3
"""Read-only Docker helper: credentials exist only in process pipes/memory."""
import json
import os
import subprocess
import sys


def credential(action, host, env):
    if action != "get":
        raise ValueError("credential writes are forbidden")
    account = env.get("PROMOTION_AWS_ACCOUNT", "")
    if account != "012619468098":
        raise ValueError("invalid account")
    if host == "ghcr.io":
        token = env.get("GH_TOKEN", "")
        if not token:
            raise ValueError("missing package reader")
        return {"Username": "x-access-token", "Secret": token}
    if host != account + ".dkr.ecr.ap-northeast-1.amazonaws.com":
        raise ValueError("registry is not authorized")
    result = subprocess.run(
        ["aws", "ecr", "get-login-password", "--region", "ap-northeast-1", "--no-cli-pager"],
        capture_output=True, timeout=30, check=False)
    if result.returncode or not 1 <= len(result.stdout) <= 16384:
        raise ValueError("registry identity unavailable")
    return {"Username": "AWS", "Secret": result.stdout.decode().strip()}


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("invalid command")
        host = sys.stdin.buffer.read(257)
        if len(host) > 256:
            raise ValueError("invalid registry")
        print(json.dumps(credential(sys.argv[1], host.decode().strip(), os.environ)))
    except Exception:
        print("promotion credential request refused", file=sys.stderr)
        sys.exit(1)
