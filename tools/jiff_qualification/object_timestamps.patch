-    use chrono::{DateTime, TimeZone};
+    use jiff::{Timestamp, tz::TimeZone};
     use serde::{self, Deserialize, Deserializer};

-    pub(crate) fn deserialize<'de, D>(deserializer: D) -> Result<DateTime<chrono::Local>, D::Error>
+    pub(crate) fn deserialize<'de, D>(deserializer: D) -> Result<Timestamp, D::Error>
     where
         D: Deserializer<'de>,
     {
-        let s = String::deserialize(deserializer)?;
-        // expiresOn from azure cli uses the local timezone
-        let date = chrono::NaiveDateTime::parse_from_str(&s, "%Y-%m-%d %H:%M:%S.%6f")
-            .map_err(serde::de::Error::custom)?;
-        chrono::Local
-            .from_local_datetime(&date)
-            .single()
-            .ok_or(serde::de::Error::custom(
-                "azure cli returned ambiguous expiry date",
-            ))
+        let local = String::deserialize(deserializer)?;
+        let zone = TimeZone::try_system().map_err(serde::de::Error::custom)?;
+        parse(&local, &zone)
+    }
+
+    fn parse<E: serde::de::Error>(local: &str, zone: &TimeZone) -> Result<Timestamp, E> {
+        // expiresOn is a local civil time. Unknown zones and DST folds/gaps have
+        // no authoritative single expiry instant.
+        if zone.is_unknown() {
+            return Err(E::custom("unknown Azure CLI expiry time zone"));
+        }
+        let civil = jiff::civil::DateTime::strptime("%Y-%m-%d %H:%M:%S.%6f", local)
+            .map_err(E::custom)?;
+        zone.to_ambiguous_zoned_datetime(civil)
+            .unambiguous()
+            .map(|date| date.timestamp())
+            .map_err(E::custom)
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn local_expiry_requires_one_known_instant() {
+            let eastern = TimeZone::get("America/New_York").unwrap();
+            let parse = |date, zone| super::parse::<serde_json::Error>(date, zone);
+            let end = parse("2026-03-08 03:30:00.123456", &eastern).unwrap();
+            assert_eq!(end, "2026-03-08T07:30:00.123456Z".parse::<Timestamp>().unwrap());
+            let start = parse("2026-03-08 01:30:00.123456", &eastern).unwrap();
+            assert_eq!((end - start).as_secs(), 3600);
+            assert!(parse("2026-03-08 02:30:00.000000", &eastern).is_err());
+            assert!(parse("2026-11-01 01:30:00.000000", &eastern).is_err());
+            assert!(parse("2026-11-01 07:30:00.000000", &TimeZone::unknown()).is_err());
+        }
     }
 }

