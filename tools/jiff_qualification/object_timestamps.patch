+#[cfg(test)]
+mod checked_modified_tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn file_mtime_preserves_nanoseconds_or_returns_an_error() {
+        let path = Path::from("dated.parquet");
+        let epoch = SystemTime::UNIX_EPOCH;
+        let tick = Duration::from_nanos(1);
+        for (input, expected) in [(epoch - tick, -1), (epoch, 0), (epoch + tick, 1)] {
+            assert_eq!(checked_modified(Ok(input), &path).unwrap().as_nanosecond(), expected);
+        }
+        let too_late = epoch + Duration::from_secs(253_402_300_800);
+        assert!(checked_modified(Ok(too_late), &path).is_err());
+        assert!(checked_modified(Err(std::io::Error::other("no mtime")), &path).is_err());
+    }
+}
