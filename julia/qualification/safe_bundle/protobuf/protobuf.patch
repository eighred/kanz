@@ -5,6 +5,37 @@ function decode_tag(d::AbstractProtoDecoder)
     return field_number, wire_type
 end

+# Retain each singular embedded message's wire boundary so scalar presence,
+# repeated elements and oneof selection can be folded by the generated decoder.
+struct MessageFragments{T}
+    parts::Vector{Vector{UInt8}}
+    MessageFragments{T}() where {T} = new{T}(Vector{UInt8}[])
+end
+
+function read_fragment!(d::ProtoDecoder{IOBuffer}, buffer::MessageFragments, wire_type, endpos::Int)
+    wire_type == LENGTH_DELIMITED || throw(ArgumentError("expected a length-delimited message"))
+    io = get_stream(d)
+    size = Int(vbyte_decode(io, UInt32))
+    available = endpos == 0 ? bytesavailable(io) : min(bytesavailable(io), endpos - position(io))
+    size <= available || throw(EOFError())
+    push!(buffer.parts, read(io, size))
+    return nothing
+end
+
+function decode_fragments end
+
+function Base.getindex(buffer::MessageFragments{T}) where {T}
+    isempty(buffer.parts) && return nothing
+    segments = ((ProtoDecoder(IOBuffer(bytes)), length(bytes), false) for bytes in buffer.parts)
+    return decode_fragments(segments, T)
+end
+
+function finish_discarded!(buffer::MessageFragments)
+    buffer[]
+    Base.empty!(buffer.parts)
+    return nothing
+end
+
 const _ScalarTypes = Union{Float64,Float32,Int32,Int64,UInt64,UInt32,Bool,String,Vector{UInt8}}
 const _ScalarTypesEnum = Union{_ScalarTypes,Enum}

