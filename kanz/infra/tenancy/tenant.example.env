# One tenant, one file — the single source of truth tenantctl.sh fans out.
# Copy to <tenant>.env, edit, then: `set -a; . <tenant>.env; set +a; ./tenantctl.sh onboard`.

TENANT=acme                     # tenant id; the broker prefix / account / RLS scope / quota key
TENANT_SAS="risk-engine api-gateway"   # ServiceAccounts to mint in tenant-acme (⇒ SVIDs)

# Per-tenant gateway budget (MT-01e). Sizing is the tenant's contracted tier.
RATE_PER_SEC=50
BURST=100
MAX_IN_FLIGHT=64

# State role (MT-01d). ADMIN_DATABASE_URL is a DB-admin DSN; omit to skip DB
# provisioning. TENANT_DB_PASSWORD seeds the per-tenant login role.
# ADMIN_DATABASE_URL=postgres://admin@db:5432/risk
# TENANT_DB_PASSWORD=change-me

# NATS dynamic account onboarding via the JWT resolver (MT-01c). Set when an
# operator is configured; otherwise tenantctl prints the static-append step.
# NATS_OPERATOR=KANZ
