#!/usr/bin/env bash
set -Eeuo pipefail
exec > >(tee -a /var/log/kanz-bootstrap.log | logger -t kanz-bootstrap -s 2>/dev/console) 2>&1

readonly data_volume_id="${data_volume_id}"
readonly data_serial="$${data_volume_id//-/}"
readonly ecr_provider_revision="${ecr_provider_revision}"
readonly ecr_provider_source="/var/tmp/cloud-provider-aws-$${ecr_provider_revision}"
readonly k3s_version="${k3s_version}"
readonly install_commit="${k3s_install_commit}"
readonly install_sha="${k3s_install_sha}"
readonly install_path="/var/tmp/k3s-install.sh"

dnf install -y git golang jq nvme-cli xfsprogs

# Kubernetes removed the in-tree AWS registry integration. Build the upstream
# provider from an exact reviewed commit before k3s starts, then let kubelet
# obtain short-lived ECR authorization through the EC2 role. No registry token
# is written to cloud-init, Terraform state, a Kubernetes Secret, or this log.
git clone --filter=blob:none --no-checkout \
  https://github.com/kubernetes/cloud-provider-aws.git \
  "$${ecr_provider_source}"
git -C "$${ecr_provider_source}" checkout --detach "$${ecr_provider_revision}"
test "$(git -C "$${ecr_provider_source}" rev-parse HEAD)" = "$${ecr_provider_revision}"
install -d -m 0755 /var/lib/rancher/credentialprovider/bin
install -d -m 0755 /var/lib/rancher/credentialprovider
(
  cd "$${ecr_provider_source}"
  CGO_ENABLED=0 GOCACHE=/var/tmp/kanz-ecr-provider-cache \
    GOMODCACHE=/var/tmp/kanz-ecr-provider-modcache \
    go build -trimpath -ldflags='-s -w -buildid=' \
      -o /var/lib/rancher/credentialprovider/bin/ecr-credential-provider \
      ./cmd/ecr-credential-provider
)
chmod 0755 /var/lib/rancher/credentialprovider/bin/ecr-credential-provider
cat >/var/lib/rancher/credentialprovider/config.yaml <<'EOF'
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    matchImages:
      - "*.dkr.ecr.*.amazonaws.com"
      - "*.dkr.ecr.*.amazonaws.com.cn"
    defaultCacheDuration: 12h
    apiVersion: credentialprovider.kubelet.k8s.io/v1
EOF
rm -rf "$${ecr_provider_source}" \
  /var/tmp/kanz-ecr-provider-cache \
  /var/tmp/kanz-ecr-provider-modcache
dnf remove -y git golang

data_device=""
for _ in $(seq 1 300); do
  data_device="$(lsblk -dpno NAME,SERIAL | awk -v serial="$${data_serial}" '$2 == serial { print $1; exit }')"
  if [[ -n "$${data_device}" ]]; then
    break
  fi
  sleep 2
done
if [[ -z "$${data_device}" ]]; then
  echo "attached data volume was not discovered" >&2
  exit 1
fi

if ! blkid "$${data_device}" >/dev/null 2>&1; then
  mkfs.xfs -L KANZ_DATA "$${data_device}"
fi
mkdir -p /var/lib/rancher
data_uuid="$(blkid -s UUID -o value "$${data_device}")"
if ! grep -q "UUID=$${data_uuid}" /etc/fstab; then
  echo "UUID=$${data_uuid} /var/lib/rancher xfs defaults,nofail 0 2" >> /etc/fstab
fi
mountpoint -q /var/lib/rancher || mount /var/lib/rancher

curl --fail --location --proto '=https' --tlsv1.2 \
  "https://raw.githubusercontent.com/k3s-io/k3s/$${install_commit}/install.sh" \
  --output "$${install_path}"
echo "$${install_sha}  $${install_path}" | sha256sum --check --strict
chmod 0700 "$${install_path}"

INSTALL_K3S_VERSION="$${k3s_version}" \
INSTALL_K3S_EXEC="server --cluster-init --disable traefik --disable servicelb --secrets-encryption --write-kubeconfig-mode 0600 --etcd-snapshot-retention 7 --etcd-snapshot-schedule-cron '0 */6 * * *'" \
  "$${install_path}"

rm -f "$${install_path}"
systemctl enable --now amazon-ssm-agent
systemctl is-active --quiet k3s
for _ in $(seq 1 120); do
  if /usr/local/bin/k3s kubectl get nodes -o name 2>/dev/null | grep -q '^node/'; then
    break
  fi
  sleep 2
done
/usr/local/bin/k3s kubectl get nodes -o name | grep -q '^node/'
/usr/local/bin/k3s kubectl wait --for=condition=Ready node --all --timeout=180s
touch /var/lib/rancher/.kanz-bootstrap-complete
