{
  "uid": "kanz-data-completeness",
  "title": "Data Completeness",
  "tags": ["kanz", "data-integrity", "completeness"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "subject",
        "label": "Subject",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Missing events / 1h",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kanz_data_gap_missing_total{subject=~\"$subject\"}[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reconcile discrepancies / 1h",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kanz_data_reconcile_discrepancies_total[1h]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pending cross-transport",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kanz_data_reconcile_pending)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gap missing-event rate by subject",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (subject, partition_key) (rate(kanz_data_gap_missing_total{subject=~\"$subject\"}[5m]))",
          "legendFormat": "{{subject}} / {{partition_key}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reconcile discrepancies (seen vs missing)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (seen_on, missing_on) (rate(kanz_data_reconcile_discrepancies_total[5m]))",
          "legendFormat": "seen {{seen_on}} / missing {{missing_on}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "NATS↔Kafka match latency (p50 / p99)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kanz_data_reconcile_match_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kanz_data_reconcile_match_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pending cross-transport by transport",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "kanz_data_reconcile_pending",
          "legendFormat": "{{transport}}"
        }
      ]
    }
  ]
}
