{
  "uid": "kanz-data-freshness",
  "title": "Data Freshness",
  "tags": ["kanz", "data-integrity", "freshness"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "subject",
        "label": "Subject",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Max staleness lag",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kanz_data_staleness_lag_seconds{subject=~\"$subject\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Streams stale (> 10s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kanz_data_staleness_lag_seconds{subject=~\"$subject\"} > 10) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Staleness events / 5m",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kanz_data_quality_events_total{kind=\"staleness\",subject=~\"$subject\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Staleness lag by subject / partition",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "kanz_data_staleness_lag_seconds{subject=~\"$subject\"}",
          "legendFormat": "{{subject}} / {{partition_key}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Stale-frontier age (now - last_event_time)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "kanz_data_last_event_age_seconds{subject=~\"$subject\"}",
          "legendFormat": "{{subject}} / {{partition_key}}"
        }
      ]
    }
  ]
}
