{
  "name": "kanz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-renderer.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-renderer.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "playwright": "1.64.1",
    "typescript": "5.7.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      },
      "editorconfig": {
        "minimatch": "11.0.1"
      }
    }
  }
}
