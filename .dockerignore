# Keep the docker build context lean and deterministic. NOTE: schemas/gen/go
# is deliberately NOT ignored — the service builds depend on it (it's the
# generated SDK the go.mod `replace` points at). Other gen/ trees aren't copied.
.git
**/.gotmp
**/node_modules
**/__pycache__
**/.pytest_cache
rust/target
rust/target-provenance
rust/temporal_sources/generated
rust/temporal_sources/.prepared-*
schemas/gen/python
schemas/gen/ts
